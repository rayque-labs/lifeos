# Desenvolvimento local (PostgreSQL em produção)
DATABASE_URL=sqlite:///./lifeos.db
SQL_ECHO=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
JWT_SECRET=change-me-generate-a-unique-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
PASSWORD_RESET_MINUTES=30
FRONTEND_URL=http://localhost:5173
# Configure these to enable password recovery. No email is sent in development until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
